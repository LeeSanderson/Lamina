<Project>
  <!--
    Keep SonarAnalyzer.CSharp out of the compiler. It arrives transitively from Opinionated.DotNet.CodingStandards.
    Versions 10.3 and later are under the SONAR Source-Available License, which excludes AI tools acting on its
    output, and this repository is developed with AI agents. ExcludeAssets does not stop the SDK loading it,
    so the analyzer is removed after package assets are resolved. See docs/spikes/s7-repo-scaffold.md.
  -->
  <Target Name="LaminaRemoveSonarAnalyzer" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'SonarAnalyzer.CSharp'" />
    </ItemGroup>
  </Target>
</Project>
