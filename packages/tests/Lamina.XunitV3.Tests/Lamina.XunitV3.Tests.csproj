<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.v3.runner.utility" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
    <Using Include="VerifyXunit.Verifier" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lamina.XunitV3\Lamina.XunitV3.csproj" />
    <ProjectReference Include="..\..\src\Lamina.XunitV3.Generators\Lamina.XunitV3.Generators.csproj" />
    <ProjectReference Include="..\Lamina.XunitV3.Tests.Samples\Lamina.XunitV3.Tests.Samples.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SamplesAssembly</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\Lamina.XunitV3.Tests.Samples\bin\$(Configuration)\$(TargetFramework)\Lamina.XunitV3.Tests.Samples.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
