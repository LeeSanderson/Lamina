{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Clients": {
    "PaymentProvider": "http://payment-provider",
    "Ordering": "https+http://ordering"
  },
  "PaymentProvider": {
    "Timeout": "00:00:05",
    "Retry": {
      "FirstBackOff": "00:00:02",
      "Attempts": 5
    }
  }
}
